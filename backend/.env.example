# CONCEPTPE Backend Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins
CLIENT_ORIGIN=*

# API Prefix
API_PREFIX=/api

# YouTube Data API v3 Configuration
# Obtain your API key from Google Cloud Console (YouTube Data API v3)
YOUTUBE_API_KEY=
# Optional: Set the resolved channel ID directly if known (otherwise auto-resolved from handle)
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=@Conceptpe
# Cache TTL in minutes (default 30)
YOUTUBE_CACHE_MINUTES=30

# SMTP Email Configuration (for Contact Form)
# Configure your SMTP provider (e.g., Gmail, Outlook, SendGrid, Mailgun)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, use App Password for SMTP_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=anamikacse999@gmail.com
